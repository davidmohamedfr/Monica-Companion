  group('SqliteReminderRepository - findNextDueByContactId', () {
    testWidgets('should find next due active reminder for contact ordered by due_date ASC', (WidgetTester tester) async {
      final Map<String, dynamic> nextDueReminder = mockRemindersResponse[0]; // Future reminder
      when(() => mockDatabase.rawQuery(any(), any())).thenAnswer((_) async => <Map<String, dynamic>>[
        nextDueReminder,
      ]);

      final Reminder? result = await repository.findNextDueByContactId(testContactId);

      expect(result, isNotNull);
      expect(result!.contactId, equals(testContactId));
      expect(result.active, isTrue);
      verify(() => mockDatabase.rawQuery(
        '''
        SELECT * FROM reminders
        WHERE contact_id = ? AND active = 1 AND due_date >= ?
        ORDER BY due_date ASC
        LIMIT 1
      ''',
        <dynamic>[testContactId, any()], // DateTime.now() value will vary
      )).called(1);
    });

    testWidgets('should return null when no next due reminder for contact', (WidgetTester tester) async {
      when(() => mockDatabase.rawQuery(any(), any())).thenAnswer((_) async => <Map<String, dynamic>>[]);

      final Reminder? result = await repository.findNextDueByContactId(999);

      expect(result, isNull);
      verify(() => mockDatabase.rawQuery(any(), any())).called(1);
    });

    testWidgets('should only find active reminders in future', (WidgetTester tester) async {
      final Map<String, dynamic> futureActiveReminder = <String, dynamic>{
        ...mockRemindersResponse[0],
        'active': 1,
        'due_date': DateTime.now().add(const Duration(days: 1)).toIso8601String(),
      };
      when(() => mockDatabase.rawQuery(any(), any())).thenAnswer((_) async => <Map<String, dynamic>>[
        futureActiveReminder,
      ]);

      final Reminder? result = await repository.findNextDueByContactId(testContactId);

      expect(result, isNotNull);
      expect(result!.active, isTrue);
      verify(() => mockDatabase.rawQuery(
        any(),
        any(),
      )).called(1);
    });

