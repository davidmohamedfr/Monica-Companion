  group('SqliteReminderRepository - fromMap', () {
    testWidgets('should correctly convert database map to Reminder model with all fields', (WidgetTester tester) async {
      final Map<String, dynamic> completeReminderMap = mockRemindersResponse[0];

      final Reminder result = repository.fromMap(completeReminderMap);

      expect(result.id, equals(1));
      expect(result.contactId, equals(123));
      expect(result.title, equals('Call John for birthday'));
      expect(result.description, equals('Remember to wish happy birthday'));
      expect(result.dueDate, equals(futureDate.toIso8601String()));
      expect(result.frequency, equals(ReminderFrequency.yearly));
      expect(result.active, isTrue);
      expect(result.createdAt, isA<DateTime>());
    });

    testWidgets('should handle null values correctly when converting from map', (WidgetTester tester) async {
      final Map<String, dynamic> reminderWithNulls = mockRemindersResponse[1];

      final Reminder result = repository.fromMap(reminderWithNulls);

      expect(result.id, equals(2));
      expect(result.contactId, equals(456));
      expect(result.title, equals('Weekly check-in with team'));
      expect(result.description, isNull);
      expect(result.frequency, equals(ReminderFrequency.weekly));
      expect(result.active, isTrue);
    });

    testWidgets('should handle active status conversion correctly', (WidgetTester tester) async {
      final Map<String, dynamic> inactiveReminderMap = mockRemindersResponse[2]; // active: 0

      final Reminder result = repository.fromMap(inactiveReminderMap);

      expect(result.active, isFalse); // active: 0 -> false
      expect(result.frequency, equals(ReminderFrequency.yearly));
    });
  });

  group('SqliteReminderRepository - Edge Cases', () {
    testWidgets('should handle very long reminder titles', (WidgetTester tester) async {
      final String longTitle = 'A' * 1000; // Very long title
      when(() => mockDatabase.rawQuery(any(), any())).thenAnswer((_) async => <Map<String, dynamic>>[]);

      final List<Reminder> result = await repository.findByTitle(longTitle);

      expect(result, isEmpty);
      verify(() => mockDatabase.rawQuery(any(), <dynamic>['%$longTitle%'])).called(1);
    });

    testWidgets('should handle unicode characters in search', (WidgetTester tester) async {
      const String unicodeTitle = '🎉 Birthday 📅';
      when(() => mockDatabase.rawQuery(any(), any())).thenAnswer((_) async => <Map<String, dynamic>>[]);

      final List<Reminder> result = await repository.findByTitle(unicodeTitle);

      expect(result, isEmpty);
      verify(() => mockDatabase.rawQuery(any(), <dynamic>['%$unicodeTitle%'])).called(1);
    });

    testWidgets('should handle very large contact IDs', (WidgetTester tester) async {
      const int largeContactId = 2147483647; // Max int32
      when(() => mockDatabase.rawQuery(any(), any())).thenAnswer((_) async => <Map<String, dynamic>>[]);

      final List<Reminder> result = await repository.findByContactId(largeContactId);

      expect(result, isEmpty);
      verify(() => mockDatabase.rawQuery(any(), <dynamic>[largeContactId])).called(1);
    });

    testWidgets('should handle very old dates', (WidgetTester tester) async {
      final DateTime veryOldDate = DateTime(1900, 1, 1);
      final DateTime recentDate = DateTime(2024, 12, 31);
      when(() => mockDatabase.rawQuery(any(), any())).thenAnswer((_) async => <Map<String, dynamic>>[]);

      final List<Reminder> result = await repository.findByDateRange(veryOldDate, recentDate);

      expect(result, isEmpty);
      verify(() => mockDatabase.rawQuery(any(), any())).called(1);
    });

    testWidgets('should handle simultaneous frequency queries', (WidgetTester tester) async {
      // Test that different frequency types can be queried without interference
      when(() => mockDatabase.rawQuery(any(), any())).thenAnswer((_) async => <Map<String, dynamic>>[]);

      final List<Reminder> dailyResults = await repository.findByFrequency(ReminderFrequency.daily);
      final List<Reminder> weeklyResults = await repository.findByFrequency(ReminderFrequency.weekly);
      final List<Reminder> monthlyResults = await repository.findByFrequency(ReminderFrequency.monthly);

      expect(dailyResults, isEmpty);
      expect(weeklyResults, isEmpty);
      expect(monthlyResults, isEmpty);
      verify(() => mockDatabase.rawQuery(any(), <dynamic>['daily'])).called(1);
      verify(() => mockDatabase.rawQuery(any(), <dynamic>['weekly'])).called(1);
      verify(() => mockDatabase.rawQuery(any(), <dynamic>['monthly'])).called(1);
    });

    testWidgets('should handle extreme days ahead values for upcoming reminders', (WidgetTester tester) async {
      const int extremeDaysAhead = 999999;
      when(() => mockDatabase.rawQuery(any(), any())).thenAnswer((_) async => <Map<String, dynamic>>[]);

      final List<Reminder> result = await repository.findUpcoming(extremeDaysAhead);

      expect(result, isEmpty);
      verify(() => mockDatabase.rawQuery(any(), any())).called(1);
    });
  });
