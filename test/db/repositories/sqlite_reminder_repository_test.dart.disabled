      final List<Map<String, dynamic>> orderedTitleMatches = <Map<String, dynamic>>[
        <String, dynamic>{...mockRemindersResponse[3], 'due_date': '2024-01-10T09:00:00.000Z', 'title': 'Project deadline reminder'}, // Earlier
        <String, dynamic>{...mockRemindersResponse[0], 'due_date': '2024-01-20T09:00:00.000Z', 'title': 'Monthly reminder'}, // Later
      ];

